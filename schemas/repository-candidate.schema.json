{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/repository-candidate.schema.json",
  "title": "GitHub Repository Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["full_name", "html_url", "default_branch", "archived", "stars", "forks", "discovery_query"],
  "properties": {
    "full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "html_url": {"type": "string", "format": "uri"},
    "description": {"type": ["string", "null"]},
    "default_branch": {"type": "string", "minLength": 1},
    "pushed_at": {"type": ["string", "null"], "format": "date-time"},
    "archived": {"type": "boolean"},
    "stars": {"type": "integer", "minimum": 0},
    "forks": {"type": "integer", "minimum": 0},
    "discovery_query": {"type": "string", "minLength": 1}
  }
}
