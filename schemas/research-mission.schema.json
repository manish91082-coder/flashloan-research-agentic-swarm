{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manish91082-coder/flashloan-research-agentic-swarm/blob/main/schemas/research-mission.schema.json",
  "title": "Autonomous Research Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "title",
    "objective",
    "domain",
    "scope",
    "research_depth",
    "agent_policy",
    "safety_policy",
    "deliverables"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 20,
      "maxLength": 5000
    },
    "domain": {
      "type": "string",
      "enum": [
        "flash_loan_arbitrage",
        "defi_liquidation",
        "protocol_security",
        "mev_and_execution",
        "cross_protocol_research",
        "general_defi_research"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "uniqueItems": true,
          "default": [
            "Ethereum",
            "Polygon",
            "Arbitrum",
            "Base"
          ]
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "uniqueItems": true
        },
        "repository_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "include_archived": {
          "type": "boolean",
          "default": false
        },
        "include_older_references": {
          "type": "boolean",
          "default": true
        },
        "date_cutoff": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "research_depth": {
      "type": "string",
      "enum": [
        "screening",
        "standard",
        "deep_forensic",
        "full_audit"
      ]
    },
    "agent_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "independent_review",
        "max_parallel_agents",
        "max_iterations"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "autonomous",
            "approval_gated",
            "supervised"
          ]
        },
        "independent_review": {
          "type": "boolean",
          "const": true
        },
        "max_parallel_agents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 5
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "specialists": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "research_director",
              "github_discovery",
              "protocol_specialist",
              "solidity_security",
              "execution_engineer",
              "test_verification",
              "economics_quant",
              "dependency_license",
              "evidence_auditor",
              "independent_reviewer",
              "continuity_documentation"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "safety_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "execute_candidate_code",
        "wallet_access",
        "sign_transactions",
        "deploy_contracts",
        "live_trading",
        "paid_services"
      ],
      "properties": {
        "research_only": {
          "type": "boolean",
          "const": true
        },
        "execute_candidate_code": {
          "type": "boolean",
          "const": false
        },
        "wallet_access": {
          "type": "boolean",
          "const": false
        },
        "sign_transactions": {
          "type": "boolean",
          "const": false
        },
        "deploy_contracts": {
          "type": "boolean",
          "const": false
        },
        "live_trading": {
          "type": "boolean",
          "const": false
        },
        "paid_services": {
          "type": "boolean",
          "const": false
        },
        "allow_free_model_inference": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "candidate_matrix",
          "protocol_architecture",
          "source_audits",
          "security_findings",
          "test_and_ci_evidence",
          "profitability_model",
          "dependency_license_report",
          "evidence_register",
          "executive_summary",
          "next_research_queue"
        ]
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
