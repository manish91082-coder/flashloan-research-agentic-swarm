{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-record.schema.json",
  "title": "Flash Loan Research Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "commit_sha", "path", "blob_sha", "claim_type", "claim", "evidence_excerpt", "confidence", "acceptance_status"],
  "properties": {
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "path": {"type": "string", "minLength": 1},
    "blob_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "claim_type": {"enum": ["observed_fact", "inference", "hypothesis", "unknown"]},
    "claim": {"type": "string", "minLength": 1},
    "evidence_excerpt": {"type": "string"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "acceptance_status": {"enum": ["pending", "accepted", "rejected", "needs_human_review"]}
  }
}
