{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manish91082-coder/flashloan-research-agentic-swarm/blob/main/research/R15D_REVIEWER_SUBMISSION.schema.json",
  "title": "R15D single-reviewer blind submission",
  "description": "One reviewer's private six-case bundle. This structural schema does not prove real-world identity or independence; those require out-of-band custodian verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "reviewer_id",
    "submitted_at",
    "attestations",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "const": "r15d-semantic-source-facts-v1"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_review",
        "model_outputs_not_seen",
        "other_reviews_not_seen",
        "conflicts_disclosed",
        "conflict_statement"
      ],
      "properties": {
        "independent_review": {
          "const": true
        },
        "model_outputs_not_seen": {
          "const": true
        },
        "other_reviews_not_seen": {
          "const": true
        },
        "conflicts_disclosed": {
          "const": true
        },
        "conflict_statement": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_pin",
          "label",
          "rationale",
          "evidence_references",
          "confidence",
          "completed_at"
        ],
        "properties": {
          "case_id": {
            "enum": [
              "NAV-01",
              "NAV-02",
              "NAV-03",
              "COB-01",
              "COB-02",
              "COB-03"
            ]
          },
          "source_pin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commit_sha",
              "tree_sha",
              "path",
              "git_blob_sha1",
              "line_start",
              "line_end",
              "excerpt_sha256"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "tree_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "git_blob_sha1": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "excerpt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "label": {
            "enum": [
              "present",
              "absent",
              "not_applicable",
              "unknown"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
